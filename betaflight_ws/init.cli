# Reset configuration
defaults

# Set the SITL communication ports for Gazebo
set sitl_host = 127.0.0.1
set sitl_port = 9002
set sitl_port_in = 9003

# Enable MAVLink on UART1
feature MAVLINK
serial 0 1 115200 115200 0 0

# Set motor mixer to Quad X
mixer QUADX

# PID and ESC settings for SITL stability (per documentation)
set pid_process_denom = 1
set gyro_sync_denom = 1
# ESC/Motor: PWM, disable Motor PWM speed Separated from PID speed
# This is usually done in the configuration tab or via CLI
# set motor_pwm_protocol = PWM (default)

# Configure Arming switch on AUX1 (Channel 5)
aux 0 0 0 1700 2100

# Save and reboot
save
