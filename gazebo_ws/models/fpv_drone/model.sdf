<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="fpv_drone">
    <pose>0 0 0.1 0 0 0</pose>

    <!-- Base Link -->
    <link name="base_link">
      <inertial>
        <mass>0.8</mass> <!-- Approx weight for a 7-inch drone -->
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.009</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box><size>0.2 0.2 0.05</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.2 0.2 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
      </sensor>
    </link>

    <!-- Rotors (4 for Quadcopter) -->
    <!-- Front Right -->
    <link name="rotor_0">
      <pose>0.15 -0.15 0.03 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.09</radius><length>0.01</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Front Left -->
    <link name="rotor_1">
      <pose>0.15 0.15 0.03 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.09</radius><length>0.01</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Back Left -->
    <link name="rotor_2">
      <pose>-0.15 0.15 0.03 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.09</radius><length>0.01</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Back Right -->
    <link name="rotor_3">
      <pose>-0.15 -0.15 0.03 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-06</ixx><iyy>1e-06</iyy><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.09</radius><length>0.01</length></cylinder>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Betaflight Plugin (mkschreder/gazebo-betaflight) -->
    <plugin name="betaflight_interface" filename="libgazebo_betaflight_plugin.so">
      <robotNamespace></robotNamespace>
      <address>127.0.0.1</address>
      <port>9002</port>
      <commandPort>9003</commandPort>
      <!-- Motor mapping for the plugin -->
      <motor count="4">
        <joint>rotor_0_joint</joint>
        <joint>rotor_1_joint</joint>
        <joint>rotor_2_joint</joint>
        <joint>rotor_3_joint</joint>
      </motor>
    </plugin>
  </model>
</sdf>
